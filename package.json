{
  "name": "aive-ingest",
  "version": "1.0.0",
  "private": true,
  "description": "Public-data ingest workers for AIVE (MCP registry, endpoint probes, server/discover, governance mirror, Homebrew formulae, npm SDK packages, webhook providers)",
  "scripts": {
    "ingest:mcp-registry": "tsx workers/ingest-mcp-registry.ts",
    "ingest:webhook-providers": "tsx workers/ingest-webhook-providers.ts",
    "ingest:homebrew-formulae": "tsx workers/ingest-homebrew-formulae.ts",
    "ingest:npm-sdk": "tsx workers/ingest-npm-sdk-packages.ts",
    "ingest:mcp-governance": "tsx workers/ingest-mcp-governance.ts",
    "probe:mcp-endpoints": "tsx workers/probe-mcp-endpoints.ts",
    "discover:mcp-servers": "tsx workers/discover-mcp-servers.ts",
    "collect:mcp-tools": "tsx workers/collect-mcp-tools.ts",
    "collect:mcp-resources": "tsx workers/collect-mcp-resources.ts",
    "collect:mcp-prompts": "tsx workers/collect-mcp-prompts.ts",
    "verify:list-collectors": "tsx scripts/verify-list-collectors.ts",
    "verify:host-backoff": "tsx scripts/verify-host-backoff.ts",
    "typecheck": "tsc --noEmit",
    "verify:rejection-parsing": "tsx scripts/verify-rejection-parsing.ts",
    "verify:write-access": "tsx scripts/verify-write-access.ts",
    "verify:tools-collector": "tsx scripts/verify-tools-collector.ts",
    "verify:throw-isolation": "tsx scripts/verify-throw-isolation.ts",
    "verify:exclusions": "tsx scripts/verify-exclusions.ts",
    "verify:mcp-registry-outcome": "tsx scripts/verify-mcp-registry-outcome.ts",
    "verify:registry-retry": "tsx scripts/verify-registry-retry.ts",
    "verify:probe-run-evidence": "tsx scripts/verify-probe-run-evidence.ts",
    "verify:tool-collection-evidence": "tsx scripts/verify-tool-collection-evidence.ts",
    "watchdog": "tsx workers/ingest-watchdog.ts",
    "broadcast:text-card": "tsx workers/broadcast-text-card.ts",
    "broadcast:quiz-card": "tsx workers/broadcast-quiz-card.ts",
    "verify:insert-conflict-sql": "tsx scripts/verify-insert-conflict-sql.ts"
  },
  "dependencies": {
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "20.10.6",
    "@types/pg": "^8.20.1",
    "tsx": "^4.20.6",
    "typescript": "5.4.5"
  }
}
